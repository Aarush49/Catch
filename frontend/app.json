{
  "expo": {
    "name": "Catch",
    "slug": "catch-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/catch-icon.png",
    "scheme": "catch",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Catch to use your camera to scan receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/catch-logo.png",
          "imageWidth": 210,
          "backgroundColor": "#EAE4D9",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/catch-icon.png",
        "backgroundColor": "#EAE4D9"
      }
    },
    "web": {
      "favicon": "./assets/catch-icon.png"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

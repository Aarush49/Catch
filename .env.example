# Copy to .env. Keep credentials on the backend; never commit .env.
# Supabase project HTTPS URL and backend secret key (sb_secret_...).
# Use the project URL, not a PostgreSQL connection string or /rest/v1 URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Receipt parsing (unneeded when MOCK_MODE=true).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_MODE=false

# Only needed for the Nessie routes.
NESSIE_API_KEY=

# Reserved for the separate shopping integration branch.
SERPAPI_KEY=

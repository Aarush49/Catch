# Backend only. Copy to .env if it does not already exist; never commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Optional Gemini model override shared by receipt parsing and predictions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Applies to the legacy /receipts/scan demo route only.
MOCK_MODE=false

NESSIE_API_KEY=
SERPAPI_KEY=
# Legacy placeholder retained for compatibility; active AI calls use GEMINI_API_KEY.
LLM_API_KEY=

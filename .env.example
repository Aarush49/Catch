# Backend only. Copy to .env if it does not already exist; never commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Secret (service-role) key. Only used for bank data and the shopping-list API.
SUPABASE_SECRET_KEY=
# Session tokens are verified against SUPABASE_URL/auth/v1/.well-known/jwks.json.
# Only set this for a project still on the legacy shared JWT secret.
SUPABASE_JWT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

NESSIE_API_KEY=
SERPAPI_KEY=

# Copy to frontend/.env. These values ship inside the app, so never put a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable (sb_publishable_...) or legacy anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The backend, reachable from your phone: use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
EXPO_PUBLIC_DEMO_MODE=false
